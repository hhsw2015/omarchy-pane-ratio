#!/usr/bin/env python3
"""Safely apply ratio presets to exactly two horizontal Dwindle windows."""

from __future__ import annotations

import json
import math
import os
import re
import fcntl
import selectors
import shutil
import signal
import stat
import subprocess
import sys
import time
from dataclasses import dataclass
from contextlib import contextmanager
from pathlib import Path
from typing import Any


PRESETS = {
    "1:3": (0.500000, 1 / 4),
    "1:2": (0.666667, 1 / 3),
    "1:1": (1.000000, 1 / 2),
    "2:1": (1.333333, 2 / 3),
    "3:1": (1.500000, 3 / 4),
}
ADDRESS_RE = re.compile(r"0x[0-9A-Fa-f]+")
MAX_WORKSPACE_BYTES = 65536
MAX_CLIENTS_BYTES = 1048576
MAX_OPTION_BYTES = 16384
MAX_EVAL_BYTES = 65536
MAX_CLIENTS = 4096
COMMAND_TIMEOUT_SECONDS = 2.0
APPLY_TIMEOUT_SECONDS = 5.0
LOCK_TIMEOUT_SECONDS = 20.0
RATIO_TOLERANCE = 0.035
MAX_STATE_BYTES = 65536
MAX_CONFIG_BYTES = 16384
MAX_WORKSPACE_NAME_CHARS = 128
STATE_SCHEMA_VERSION = 1
WORKSPACE_LAYOUTS = ("dwindle", "scrolling")


class PaneRatioError(RuntimeError):
    """Expected operational or validation failure."""


class WorkspaceLayoutPersistenceError(PaneRatioError):
    """Persistence failed, with whether atomic replacement already occurred."""

    def __init__(self, message: str, *, committed: bool) -> None:
        super().__init__(message)
        self.committed = committed


class ActiveWorkspaceChangedError(PaneRatioError):
    """The user changed workspace during a guarded operation."""


@dataclass(frozen=True)
class LayoutState:
    workspace: int
    workspace_name: str
    layout: str
    tiled_windows: int
    orientation: str
    ratio: str
    left_share: float | None
    addresses: tuple[str, ...]
    active_address: str
    eligible: bool
    message: str
    phase: str = "unknown"
    intent_ratio: str = ""

    @property
    def split_eligible(self) -> bool:
        return (
            self.workspace >= 0
            and self.layout == "dwindle"
            and self.tiled_windows == 2
            and self.orientation in ("horizontal", "vertical")
            and self.active_address in self.addresses
        )

    @property
    def layout_eligible(self) -> bool:
        return self.workspace >= 0 and self.layout in WORKSPACE_LAYOUTS

    def public(
        self, *, ok: bool = True, presets: dict[str, tuple[float, float]] | None = None
    ) -> dict[str, Any]:
        payload = {
            "ok": ok,
            "eligible": self.eligible,
            "workspace": self.workspace,
            "workspaceName": self.workspace_name,
            "layout": self.layout,
            "tiledWindows": self.tiled_windows,
            "orientation": self.orientation,
            "ratio": self.ratio,
            "intentRatio": self.intent_ratio,
            "state": self.phase,
            "splitEligible": self.split_eligible,
            "layoutEligible": self.layout_eligible,
            "message": self.message,
        }
        if presets is not None:
            payload["presets"] = [
                {"label": label, "leftShare": values[1]}
                for label, values in presets.items()
            ]
        return payload

    def with_intent(self, ratio: str, phase: str, message: str) -> "LayoutState":
        return LayoutState(
            self.workspace,
            self.workspace_name,
            self.layout,
            self.tiled_windows,
            self.orientation,
            self.ratio,
            self.left_share,
            self.addresses,
            self.active_address,
            self.eligible,
            message,
            phase,
            ratio,
        )


def _config_path() -> Path:
    override = os.environ.get("PANE_RATIO_CONFIG_FILE")
    if override:
        return Path(override)
    xdg_config = os.environ.get("XDG_CONFIG_HOME")
    base = Path(xdg_config) if xdg_config else Path.home() / ".config"
    return base / "omarchy-pane-ratio" / "presets.json"


def _preset(label: Any) -> tuple[str, tuple[float, float]]:
    if not isinstance(label, str) or re.fullmatch(r"[1-9][0-9]?:[1-9][0-9]?", label) is None:
        raise PaneRatioError("custom presets must use LEFT:RIGHT positive integers")
    left, right = (int(part) for part in label.split(":"))
    if left > 20 or right > 20:
        raise PaneRatioError("custom preset sides must be between 1 and 20")
    divisor = math.gcd(left, right)
    left //= divisor
    right //= divisor
    canonical = f"{left}:{right}"
    share = left / (left + right)
    return canonical, (share * 2, share)


def load_presets(path: Path | None = None) -> dict[str, tuple[float, float]]:
    config_path = path or _config_path()
    try:
        descriptor = os.open(
            config_path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK
        )
    except FileNotFoundError:
        return dict(PRESETS)
    except OSError as error:
        raise PaneRatioError("could not safely open Pane Ratio preset configuration") from error
    try:
        info = os.fstat(descriptor)
        if not stat.S_ISREG(info.st_mode) or info.st_size > MAX_CONFIG_BYTES:
            raise PaneRatioError("Pane Ratio preset configuration is invalid or too large")
        raw = os.read(descriptor, MAX_CONFIG_BYTES + 1)
        if len(raw) > MAX_CONFIG_BYTES:
            raise PaneRatioError("Pane Ratio preset configuration is too large")
    finally:
        os.close(descriptor)
    try:
        payload = json.loads(raw.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise PaneRatioError("Pane Ratio preset configuration contains invalid JSON") from error
    labels = payload.get("presets") if isinstance(payload, dict) and payload.get("schemaVersion") == 1 else None
    if not isinstance(labels, list) or not 1 <= len(labels) <= 9:
        raise PaneRatioError("Pane Ratio preset configuration must contain 1 to 9 presets")
    result: dict[str, tuple[float, float]] = {}
    for label in labels:
        canonical, values = _preset(label)
        if canonical in result:
            raise PaneRatioError("Pane Ratio preset configuration contains duplicate ratios")
        result[canonical] = values
    return result


class IntentStore:
    """Bounded, private, atomic storage for per-workspace ratio intentions."""

    def __init__(
        self,
        state_dir: Path | None = None,
        presets: dict[str, tuple[float, float]] | None = None,
    ) -> None:
        self.presets = presets or dict(PRESETS)
        if state_dir is None:
            override = os.environ.get("PANE_RATIO_STATE_DIR")
            if override:
                state_dir = Path(override)
            else:
                xdg_state = os.environ.get("XDG_STATE_HOME")
                state_dir = Path(xdg_state) if xdg_state else Path.home() / ".local/state"
                state_dir = state_dir / "omarchy-pane-ratio"
        self.directory = state_dir
        self.path = state_dir / "intents.json"
        self.lock_path = state_dir / ".lock"
        self._active_directory_fd: int | None = None

    def _open_directory(self) -> int:
        if not self.directory.is_absolute():
            raise PaneRatioError("Pane Ratio state directory must be absolute")
        try:
            current = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
            for component in self.directory.parts[1:]:
                if component in ("", ".", ".."):
                    raise PaneRatioError("Pane Ratio state directory is invalid")
                try:
                    os.mkdir(component, mode=0o700, dir_fd=current)
                except FileExistsError:
                    pass
                following = os.open(
                    component,
                    os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW,
                    dir_fd=current,
                )
                os.close(current)
                current = following
            os.fchmod(current, 0o700)
            return current
        except PaneRatioError:
            try:
                os.close(current)
            except (OSError, UnboundLocalError):
                pass
            raise
        except OSError as error:
            try:
                os.close(current)
            except (OSError, UnboundLocalError):
                pass
            raise PaneRatioError("could not prepare Pane Ratio state directory") from error

    @contextmanager
    def _directory(self):
        descriptor = (
            os.dup(self._active_directory_fd)
            if self._active_directory_fd is not None
            else self._open_directory()
        )
        try:
            yield descriptor
        finally:
            os.close(descriptor)

    @contextmanager
    def locked(self):
        directory_fd = self._open_directory()
        self._active_directory_fd = directory_fd
        lock_fd = -1
        try:
            lock_fd = os.open(
                ".lock",
                os.O_RDWR | os.O_CREAT | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK,
                0o600,
                dir_fd=directory_fd,
            )
            info = os.fstat(lock_fd)
            if not stat.S_ISREG(info.st_mode):
                raise PaneRatioError("Pane Ratio operation lock is not a regular file")
            os.fchmod(lock_fd, 0o600)
            deadline = time.monotonic() + LOCK_TIMEOUT_SECONDS
            while True:
                try:
                    fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                    break
                except BlockingIOError:
                    if time.monotonic() >= deadline:
                        raise PaneRatioError("Pane Ratio is busy; try again")
                    time.sleep(0.025)
            yield
        except OSError as error:
            raise PaneRatioError("could not safely lock Pane Ratio operations") from error
        finally:
            if lock_fd >= 0:
                try:
                    fcntl.flock(lock_fd, fcntl.LOCK_UN)
                finally:
                    os.close(lock_fd)
            self._active_directory_fd = None
            os.close(directory_fd)

    @staticmethod
    def _validate_workspace_name(name: str) -> None:
        if (
            not isinstance(name, str)
            or not name
            or len(name) > MAX_WORKSPACE_NAME_CHARS
            or any(ord(character) < 32 for character in name)
        ):
            raise PaneRatioError("workspace name cannot be stored safely")

    def load(self) -> dict[str, str]:
        with self._directory() as directory_fd:
            try:
                descriptor = os.open(
                    "intents.json",
                    os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK,
                    dir_fd=directory_fd,
                )
            except FileNotFoundError:
                return {}
            except OSError as error:
                raise PaneRatioError("could not safely open Pane Ratio intentions") from error
            try:
                info = os.fstat(descriptor)
                if not stat.S_ISREG(info.st_mode) or info.st_size > MAX_STATE_BYTES:
                    raise PaneRatioError("Pane Ratio intentions file is invalid or too large")
                raw = bytearray()
                while len(raw) <= MAX_STATE_BYTES:
                    chunk = os.read(descriptor, min(16384, MAX_STATE_BYTES + 1 - len(raw)))
                    if not chunk:
                        break
                    raw.extend(chunk)
                if len(raw) > MAX_STATE_BYTES:
                    raise PaneRatioError("Pane Ratio intentions file is too large")
            finally:
                os.close(descriptor)
        try:
            payload = json.loads(raw.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise PaneRatioError("Pane Ratio intentions file contains invalid JSON") from error
        if not isinstance(payload, dict) or payload.get("schemaVersion") != STATE_SCHEMA_VERSION:
            raise PaneRatioError("Pane Ratio intentions use an unsupported schema")
        workspaces = payload.get("workspaces")
        if not isinstance(workspaces, dict) or len(workspaces) > 256:
            raise PaneRatioError("Pane Ratio intentions have an invalid workspace map")
        result: dict[str, str] = {}
        for name, rule in workspaces.items():
            self._validate_workspace_name(name)
            if not isinstance(rule, dict) or rule.get("enabled") is not True:
                raise PaneRatioError("Pane Ratio intentions contain an invalid rule")
            try:
                canonical, _values = _preset(rule.get("ratio"))
            except PaneRatioError as error:
                raise PaneRatioError("Pane Ratio intentions contain an invalid rule") from error
            if canonical != rule.get("ratio"):
                raise PaneRatioError("Pane Ratio intentions contain a non-canonical rule")
            result[name] = canonical
        return result

    def save(self, intentions: dict[str, str]) -> None:
        if len(intentions) > 256:
            raise PaneRatioError("Pane Ratio cannot store more than 256 workspace rules")
        for name, ratio in intentions.items():
            self._validate_workspace_name(name)
            canonical, _values = _preset(ratio)
            if canonical != ratio:
                raise PaneRatioError("Pane Ratio intentions contain a non-canonical rule")
        payload = {
            "schemaVersion": STATE_SCHEMA_VERSION,
            "workspaces": {
                name: {"enabled": True, "ratio": ratio}
                for name, ratio in sorted(intentions.items())
            },
        }
        encoded = (json.dumps(payload, ensure_ascii=True, separators=(",", ":")) + "\n").encode()
        if len(encoded) > MAX_STATE_BYTES:
            raise PaneRatioError("Pane Ratio intentions are too large")
        temporary: str | None = None
        with self._directory() as directory_fd:
            try:
                for attempt in range(32):
                    candidate = f".intents.{os.getpid()}.{time.monotonic_ns()}.{attempt}"
                    try:
                        descriptor = os.open(
                            candidate,
                            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
                            0o600,
                            dir_fd=directory_fd,
                        )
                        temporary = candidate
                        break
                    except FileExistsError:
                        continue
                else:
                    raise PaneRatioError("could not create a temporary intentions file")
                with os.fdopen(descriptor, "wb", closefd=True) as stream:
                    stream.write(encoded)
                    stream.flush()
                    os.fsync(stream.fileno())
                try:
                    existing = os.stat("intents.json", dir_fd=directory_fd, follow_symlinks=False)
                    if stat.S_ISLNK(existing.st_mode):
                        raise PaneRatioError("Pane Ratio intentions path must not be a symlink")
                except FileNotFoundError:
                    pass
                os.replace(
                    temporary,
                    "intents.json",
                    src_dir_fd=directory_fd,
                    dst_dir_fd=directory_fd,
                )
                temporary = None
                os.fsync(directory_fd)
            except PaneRatioError:
                raise
            except OSError as error:
                raise PaneRatioError("could not save Pane Ratio intentions") from error
            finally:
                if temporary is not None:
                    try:
                        os.unlink(temporary, dir_fd=directory_fd)
                    except FileNotFoundError:
                        pass

    def set(self, workspace_name: str, ratio: str) -> None:
        intentions = self.load()
        intentions[workspace_name] = ratio
        self.save(intentions)

    def clear(self, workspace_name: str) -> None:
        intentions = self.load()
        if workspace_name in intentions:
            del intentions[workspace_name]
            self.save(intentions)


class WorkspaceLayoutStore:
    """Safely persist rules consumed by Omarchy's workspace-layout loader."""

    def __init__(self, state_dir: Path | None = None) -> None:
        if state_dir is None:
            override = os.environ.get("PANE_RATIO_LAYOUT_STATE_DIR")
            if override:
                state_dir = Path(override)
            else:
                xdg_state = os.environ.get("XDG_STATE_HOME")
                base = Path(xdg_state) if xdg_state else Path.home() / ".local/state"
                state_dir = base / "omarchy" / "workspace-layouts"
        self.directory = state_dir

    def _open_directory(self) -> int:
        if not self.directory.is_absolute():
            raise PaneRatioError("workspace layout state directory must be absolute")
        try:
            current = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
            for component in self.directory.parts[1:]:
                if component in ("", ".", ".."):
                    raise PaneRatioError("workspace layout state directory is invalid")
                try:
                    os.mkdir(component, mode=0o700, dir_fd=current)
                except FileExistsError:
                    pass
                following = os.open(
                    component,
                    os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW,
                    dir_fd=current,
                )
                os.close(current)
                current = following
            os.fchmod(current, 0o700)
            return current
        except PaneRatioError:
            try:
                os.close(current)
            except (OSError, UnboundLocalError):
                pass
            raise
        except OSError as error:
            try:
                os.close(current)
            except (OSError, UnboundLocalError):
                pass
            raise PaneRatioError("could not prepare workspace layout state") from error

    def save(self, workspace_id: int, layout: str) -> None:
        if workspace_id < 0 or layout not in WORKSPACE_LAYOUTS:
            raise PaneRatioError("invalid workspace layout rule")
        filename = f"{workspace_id}.lua"
        encoded = (
            f'hl.workspace_rule({{ workspace = "{workspace_id}", layout = "{layout}" }})\n'
        ).encode()
        directory_fd = self._open_directory()
        temporary: str | None = None
        replaced = False
        try:
            for attempt in range(32):
                candidate = f".{workspace_id}.{os.getpid()}.{time.monotonic_ns()}.{attempt}"
                try:
                    descriptor = os.open(
                        candidate,
                        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
                        0o600,
                        dir_fd=directory_fd,
                    )
                    temporary = candidate
                    break
                except FileExistsError:
                    continue
            else:
                raise PaneRatioError("could not create a temporary workspace layout rule")
            with os.fdopen(descriptor, "wb", closefd=True) as stream:
                stream.write(encoded)
                stream.flush()
                os.fsync(stream.fileno())
            try:
                existing = os.stat(filename, dir_fd=directory_fd, follow_symlinks=False)
                if stat.S_ISLNK(existing.st_mode) or not stat.S_ISREG(existing.st_mode):
                    raise PaneRatioError("workspace layout rule path is not a regular file")
            except FileNotFoundError:
                pass
            os.replace(temporary, filename, src_dir_fd=directory_fd, dst_dir_fd=directory_fd)
            temporary = None
            replaced = True
            os.fsync(directory_fd)
        except PaneRatioError:
            raise
        except OSError as error:
            raise WorkspaceLayoutPersistenceError(
                "could not persist workspace layout", committed=replaced
            ) from error
        finally:
            if temporary is not None:
                try:
                    os.unlink(temporary, dir_fd=directory_fd)
                except FileNotFoundError:
                    pass
            os.close(directory_fd)


def _kill_process(process: subprocess.Popen[bytes]) -> None:
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    process.wait()


def bounded_command(
    arguments: list[str], maximum_bytes: int, operation_deadline: float | None = None
) -> bytes:
    if operation_deadline is not None and time.monotonic() >= operation_deadline:
        raise PaneRatioError("Pane Ratio operation timed out")
    try:
        process = subprocess.Popen(
            arguments,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            start_new_session=True,
        )
    except OSError as error:
        raise PaneRatioError(f"could not start {arguments[0]}") from error
    assert process.stdout is not None and process.stderr is not None
    selector = selectors.DefaultSelector()
    selector.register(process.stdout, selectors.EVENT_READ, "stdout")
    selector.register(process.stderr, selectors.EVENT_READ, "stderr")
    output = bytearray()
    errors = bytearray()
    deadline = time.monotonic() + COMMAND_TIMEOUT_SECONDS
    if operation_deadline is not None:
        deadline = min(deadline, operation_deadline)

    try:
        while selector.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                _kill_process(process)
                raise PaneRatioError(f"{arguments[0]} timed out")
            events = selector.select(remaining)
            if not events:
                continue
            for key, _mask in events:
                chunk = os.read(key.fileobj.fileno(), 65536)
                if not chunk:
                    selector.unregister(key.fileobj)
                    continue
                destination = output if key.data == "stdout" else errors
                destination.extend(chunk)
                if len(output) + len(errors) > maximum_bytes:
                    _kill_process(process)
                    raise PaneRatioError(f"{arguments[0]} returned too much data")
        return_code = process.wait(timeout=max(0.0, deadline - time.monotonic()))
    except subprocess.TimeoutExpired as error:
        _kill_process(process)
        raise PaneRatioError(f"{arguments[0]} timed out") from error
    finally:
        selector.close()

    if return_code != 0:
        detail = errors.decode("utf-8", "replace").strip().replace("\n", " ")[:240]
        raise PaneRatioError(
            f"{arguments[0]} failed with exit status {return_code}"
            + (f": {detail}" if detail else "")
        )
    return bytes(output)


class Hyprctl:
    def __init__(self, executable: str | None = None) -> None:
        self.executable = executable or shutil.which("hyprctl") or ""
        if not self.executable or not os.path.isabs(self.executable):
            raise PaneRatioError("hyprctl was not found")

    def json(
        self, maximum_bytes: int, *arguments: str, deadline: float | None = None
    ) -> Any:
        raw = bounded_command(
            [self.executable, "-j", *arguments], maximum_bytes, deadline
        )
        try:
            return json.loads(raw.decode("utf-8"))
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise PaneRatioError("hyprctl returned invalid JSON") from error

    def eval(self, expression: str, *, deadline: float | None = None) -> None:
        bounded_command(
            [self.executable, "eval", expression], MAX_EVAL_BYTES, deadline
        )


def _integer(value: Any) -> int | None:
    return value if isinstance(value, int) and not isinstance(value, bool) else None


def _pair(value: Any) -> tuple[int, int] | None:
    if not isinstance(value, list) or len(value) != 2:
        return None
    first, second = (_integer(value[0]), _integer(value[1]))
    if first is None or second is None:
        return None
    return first, second


def _ratio_label(
    left_share: float, presets: dict[str, tuple[float, float]] = PRESETS
) -> str:
    nearest = min(presets.items(), key=lambda item: abs(item[1][1] - left_share))
    return nearest[0] if abs(nearest[1][1] - left_share) <= RATIO_TOLERANCE else "Custom"


def analyze(
    workspace: Any,
    clients: Any,
    split_bias: Any,
    presets: dict[str, tuple[float, float]] = PRESETS,
) -> LayoutState:
    if not isinstance(workspace, dict):
        raise PaneRatioError("active workspace has an unexpected shape")
    workspace_id = _integer(workspace.get("id"))
    if workspace_id is None:
        raise PaneRatioError("active workspace has no numeric ID")
    layout = workspace.get("tiledLayout")
    layout = layout if isinstance(layout, str) else "unknown"
    workspace_name = workspace.get("name")
    workspace_name = workspace_name if isinstance(workspace_name, str) and workspace_name else str(workspace_id)
    active_address = workspace.get("lastwindow")
    active_address = active_address if isinstance(active_address, str) else ""

    def unavailable(message: str, count: int = 0, orientation: str = "unknown") -> LayoutState:
        return LayoutState(
            workspace_id, workspace_name, layout, count, orientation, "", None, (), active_address, False, message
        )

    if workspace_id < 0:
        return unavailable("Special workspaces are not supported.")
    if layout != "dwindle":
        return unavailable("Pane Ratio currently supports the Dwindle layout only.")
    if workspace.get("hasfullscreen") is not False:
        return unavailable("Exit fullscreen before changing the pane ratio.")
    if not isinstance(split_bias, dict) or _integer(split_bias.get("int")) != 0:
        return unavailable("The Dwindle split_bias option must be 0 (directional).")
    if not isinstance(clients, list) or len(clients) > MAX_CLIENTS:
        raise PaneRatioError("Hyprland returned an unexpected client list")

    tiled: list[dict[str, Any]] = []
    for client in clients:
        if not isinstance(client, dict) or client.get("mapped") is not True:
            continue
        client_workspace = client.get("workspace")
        if not isinstance(client_workspace, dict) or _integer(client_workspace.get("id")) != workspace_id:
            continue
        if client.get("floating") is not False:
            continue
        tiled.append(client)

    if len(tiled) < 2:
        return unavailable(
            f"Waiting for a second tiled window; found {len(tiled)}.", len(tiled)
        )
    if len(tiled) > 2:
        return unavailable(
            f"Paused because this workspace has {len(tiled)} tiled windows.", len(tiled)
        )

    addresses: list[str] = []
    geometries: list[tuple[int, int, int, int, dict[str, Any]]] = []
    for client in tiled:
        address = client.get("address")
        position = _pair(client.get("at"))
        size = _pair(client.get("size"))
        if not isinstance(address, str) or ADDRESS_RE.fullmatch(address) is None:
            raise PaneRatioError("a tiled window has an invalid address")
        if position is None or size is None or size[0] <= 0 or size[1] <= 0:
            raise PaneRatioError("a tiled window has invalid geometry")
        if client.get("fullscreen") not in (0, False):
            return unavailable("Exit fullscreen before changing the pane ratio.", 2)
        grouped = client.get("grouped")
        if not isinstance(grouped, list) or grouped:
            return unavailable("Grouped windows are not supported.", 2)
        addresses.append(address)
        geometries.append((position[0], position[1], size[0], size[1], client))

    geometries.sort(key=lambda geometry: geometry[0])
    left, right = geometries
    overlap = min(left[1] + left[3], right[1] + right[3]) - max(left[1], right[1])
    horizontal = (
        left[0] < right[0]
        and abs((left[0] + left[2]) - right[0]) <= 16
        and overlap >= min(left[3], right[3]) * 0.9
    )
    # Window identity must not depend on `hyprctl clients` order or on equal
    # X coordinates in a vertical split. Geometry is sorted separately below.
    sorted_addresses = tuple(sorted(addresses))
    geometries.sort(key=lambda geometry: geometry[1])
    top, bottom = geometries
    horizontal_overlap = min(top[0] + top[2], bottom[0] + bottom[2]) - max(top[0], bottom[0])
    vertical = (
        top[1] < bottom[1]
        and abs((top[1] + top[3]) - bottom[1]) <= 16
        and horizontal_overlap >= min(top[2], bottom[2]) * 0.9
    )
    if not horizontal and not vertical:
        return LayoutState(
            workspace_id,
            workspace_name,
            layout,
            2,
            "unknown",
            "",
            None,
            sorted_addresses,
            active_address,
            False,
            "The two tiled windows do not form one clean split.",
        )
    if active_address not in sorted_addresses:
        return LayoutState(
            workspace_id,
            workspace_name,
            layout,
            2,
            "horizontal" if horizontal else "vertical",
            "",
            None,
            sorted_addresses,
            active_address,
            False,
            "Focus one of the two tiled windows before applying a ratio.",
        )

    if vertical:
        return LayoutState(
            workspace_id,
            workspace_name,
            layout,
            2,
            "vertical",
            "",
            None,
            sorted_addresses,
            active_address,
            False,
            "The two tiled windows are arranged top and bottom.",
        )

    left_share = left[2] / (left[2] + right[2])
    return LayoutState(
        workspace_id,
        workspace_name,
        layout,
        2,
        "horizontal",
        _ratio_label(left_share, presets),
        left_share,
        sorted_addresses,
        active_address,
        True,
        "Ready.",
    )


def read_state(
    hyprctl: Hyprctl,
    *,
    deadline: float | None = None,
    presets: dict[str, tuple[float, float]] = PRESETS,
) -> LayoutState:
    workspace = hyprctl.json(
        MAX_WORKSPACE_BYTES, "activeworkspace", deadline=deadline
    )
    clients = hyprctl.json(MAX_CLIENTS_BYTES, "clients", deadline=deadline)
    split_bias = hyprctl.json(
        MAX_OPTION_BYTES, "getoption", "dwindle:split_bias", deadline=deadline
    )
    return analyze(workspace, clients, split_bias, presets)


def apply_ratio(
    hyprctl: Hyprctl,
    ratio: str,
    presets: dict[str, tuple[float, float]] = PRESETS,
    expected_workspace: int | None = None,
) -> LayoutState:
    if ratio not in presets:
        raise PaneRatioError("unsupported ratio preset")
    deadline = time.monotonic() + APPLY_TIMEOUT_SECONDS
    first = read_state(hyprctl, deadline=deadline, presets=presets)
    if expected_workspace is not None and first.workspace != expected_workspace:
        raise ActiveWorkspaceChangedError(
            "active workspace changed before the ratio could be applied"
        )
    if not first.eligible:
        return first
    second = read_state(hyprctl, deadline=deadline, presets=presets)
    if not second.eligible or (
        first.workspace,
        first.addresses,
        first.active_address,
    ) != (
        second.workspace,
        second.addresses,
        second.active_address,
    ):
        raise PaneRatioError("workspace windows changed while applying the ratio; try again")

    exact, expected_share = presets[ratio]
    if second.left_share is not None and abs(second.left_share - expected_share) <= RATIO_TOLERANCE:
        return second.with_intent(ratio, "applied", f"Ratio {ratio} is already applied.")
    expected_addresses = ",".join(
        f'["{address}"]=true' for address in second.addresses
    )
    expression = (
        "local active=hl.get_active_window();"
        "local workspace=hl.get_active_workspace();"
        f'if active==nil or workspace==nil or active.address~="{second.active_address}" '
        f'or workspace.id~={second.workspace} or workspace.tiled_layout~="dwindle" '
        "then error(\"Pane Ratio target changed\") end;"
        "local bias=hl.get_config(\"dwindle.split_bias\");"
        "if bias~=0 then error(\"Pane Ratio split bias changed\") end;"
        f"local expected={{{expected_addresses}}};local windows={{}};"
        "for _,window in ipairs(hl.get_workspace_windows(workspace)) do "
        "if window.mapped and not window.floating then "
        "if window.fullscreen~=0 then error(\"Pane Ratio fullscreen changed\") end;"
        "if window.group~=nil then error(\"Pane Ratio group changed\") end;"
        "if window.layout==nil or window.layout.name~=\"dwindle\" then "
        "error(\"Pane Ratio layout changed\") end;"
        "if not expected[window.address] then error(\"Pane Ratio windows changed\") end;"
        "table.insert(windows,window) end end;"
        "if #windows~=2 then error(\"Pane Ratio windows changed\") end;"
        "local left=windows[1];local right=windows[2];"
        "if left.at.x>right.at.x then left,right=right,left end;"
        "local overlap=math.min(left.at.y+left.size.y,right.at.y+right.size.y)-"
        "math.max(left.at.y,right.at.y);"
        "if not (left.at.x<right.at.x and "
        "math.abs((left.at.x+left.size.x)-right.at.x)<=16 and "
        "overlap>=math.min(left.size.y,right.size.y)*0.9) then "
        "error(\"Pane Ratio orientation changed\") end;"
        f'hl.dispatch(hl.dsp.layout("splitratio {exact:.6f} exact"))'
    )
    hyprctl.eval(expression, deadline=deadline)
    remaining = deadline - time.monotonic()
    if remaining <= 0:
        raise PaneRatioError("Pane Ratio operation timed out")
    time.sleep(min(0.08, remaining))
    verified = read_state(hyprctl, deadline=deadline, presets=presets)
    if not verified.eligible or verified.workspace != first.workspace or verified.addresses != first.addresses:
        raise PaneRatioError("workspace windows changed before the ratio could be verified")
    if verified.left_share is None or abs(verified.left_share - expected_share) > RATIO_TOLERANCE:
        raise PaneRatioError("Hyprland did not apply the requested ratio")
    return LayoutState(
        verified.workspace,
        verified.workspace_name,
        verified.layout,
        verified.tiled_windows,
        verified.orientation,
        ratio,
        verified.left_share,
        verified.addresses,
        verified.active_address,
        True,
        f"Applied {ratio}.",
        "applied",
        ratio,
    )


def classify_with_intent(state: LayoutState, ratio: str) -> LayoutState:
    message_lower = state.message.lower()
    if (
        state.workspace < 0
        or state.layout != "dwindle"
        or "fullscreen" in message_lower
        or "split_bias" in message_lower
    ):
        return state.with_intent(ratio, "paused_mode", f"{ratio} saved; {state.message}")
    if state.tiled_windows < 2 and state.layout == "dwindle":
        return state.with_intent(ratio, "waiting", f"{ratio} saved; waiting for a second tiled window.")
    if state.tiled_windows > 2 and state.layout == "dwindle":
        return state.with_intent(ratio, "paused_topology", f"{ratio} saved; paused with {state.tiled_windows} tiled windows.")
    if not state.eligible:
        return state.with_intent(ratio, "paused_mode", f"{ratio} saved; {state.message}")
    if state.ratio == ratio:
        return state.with_intent(ratio, "applied", f"Ratio {ratio} is applied.")
    return state.with_intent(ratio, "eligible", f"{ratio} is ready to apply.")


def status_with_intent(hyprctl: Hyprctl, store: IntentStore) -> LayoutState:
    state = read_state(hyprctl, presets=store.presets)
    intention = store.load().get(state.workspace_name, "")
    if not intention:
        return state.with_intent("", "no_intent", "No saved ratio for this workspace.")
    if intention not in store.presets:
        return state.with_intent(
            intention,
            "paused_config",
            f"Saved ratio {intention} is not in the current preset configuration.",
        )
    return classify_with_intent(state, intention)


def reconcile(
    hyprctl: Hyprctl,
    store: IntentStore,
    expected_workspace: int | None = None,
) -> LayoutState:
    state = read_state(hyprctl, presets=store.presets)
    if expected_workspace is not None and state.workspace != expected_workspace:
        raise ActiveWorkspaceChangedError(
            "active workspace changed before its ratio could be restored"
        )
    intention = store.load().get(state.workspace_name, "")
    if not intention:
        return state.with_intent("", "no_intent", "No saved ratio for this workspace.")
    if intention not in store.presets:
        return state.with_intent(
            intention,
            "paused_config",
            f"Saved ratio {intention} is not in the current preset configuration.",
        )
    classified = classify_with_intent(state, intention)
    if classified.phase != "eligible":
        return classified
    return apply_ratio(
        hyprctl,
        intention,
        store.presets,
        expected_workspace=state.workspace,
    )


def toggle_split(hyprctl: Hyprctl, store: IntentStore) -> LayoutState:
    deadline = time.monotonic() + APPLY_TIMEOUT_SECONDS
    first = read_state(hyprctl, deadline=deadline, presets=store.presets)
    if (
        first.workspace < 0
        or first.layout != "dwindle"
        or first.tiled_windows != 2
        or first.orientation not in ("horizontal", "vertical")
        or first.active_address not in first.addresses
    ):
        return first.with_intent(
            store.load().get(first.workspace_name, ""),
            "paused_mode",
            "Split direction needs exactly two clean Dwindle panes with one focused.",
        )
    second = read_state(hyprctl, deadline=deadline, presets=store.presets)
    if (
        second.workspace,
        second.addresses,
        second.active_address,
        second.orientation,
    ) != (
        first.workspace,
        first.addresses,
        first.active_address,
        first.orientation,
    ):
        raise PaneRatioError("workspace windows changed while toggling the split")

    expected_addresses = ",".join(f'["{address}"]=true' for address in second.addresses)
    orientation_guard = (
        "if not horizontal then error(\"Pane Ratio orientation changed\") end;"
        if second.orientation == "horizontal"
        else "if not vertical then error(\"Pane Ratio orientation changed\") end;"
    )
    expression = (
        "local active=hl.get_active_window();local workspace=hl.get_active_workspace();"
        f'if active==nil or workspace==nil or active.address~="{second.active_address}" '
        f'or workspace.id~={second.workspace} or workspace.tiled_layout~="dwindle" '
        "then error(\"Pane Ratio target changed\") end;"
        "local bias=hl.get_config(\"dwindle.split_bias\");"
        "if bias~=0 then error(\"Pane Ratio split bias changed\") end;"
        f"local expected={{{expected_addresses}}};local windows={{}};"
        "for _,window in ipairs(hl.get_workspace_windows(workspace)) do "
        "if window.mapped and not window.floating then "
        "if window.fullscreen~=0 then error(\"Pane Ratio fullscreen changed\") end;"
        "if window.group~=nil then error(\"Pane Ratio group changed\") end;"
        "if window.layout==nil or window.layout.name~=\"dwindle\" then "
        "error(\"Pane Ratio layout changed\") end;"
        "if not expected[window.address] then error(\"Pane Ratio windows changed\") end;"
        "table.insert(windows,window) end end;"
        "if #windows~=2 then error(\"Pane Ratio windows changed\") end;"
        "local left=windows[1];local right=windows[2];"
        "if left.at.x>right.at.x then left,right=right,left end;"
        "local hoverlap=math.min(left.at.y+left.size.y,right.at.y+right.size.y)-"
        "math.max(left.at.y,right.at.y);"
        "local horizontal=left.at.x<right.at.x and "
        "math.abs((left.at.x+left.size.x)-right.at.x)<=16 and "
        "hoverlap>=math.min(left.size.y,right.size.y)*0.9;"
        "local top=windows[1];local bottom=windows[2];"
        "if top.at.y>bottom.at.y then top,bottom=bottom,top end;"
        "local voverlap=math.min(top.at.x+top.size.x,bottom.at.x+bottom.size.x)-"
        "math.max(top.at.x,bottom.at.x);"
        "local vertical=top.at.y<bottom.at.y and "
        "math.abs((top.at.y+top.size.y)-bottom.at.y)<=16 and "
        "voverlap>=math.min(top.size.x,bottom.size.x)*0.9;"
    ) + orientation_guard + 'hl.dispatch(hl.dsp.layout("togglesplit"))'
    hyprctl.eval(expression, deadline=deadline)
    remaining = deadline - time.monotonic()
    if remaining <= 0:
        raise PaneRatioError("Pane Ratio operation timed out")
    time.sleep(min(0.08, remaining))
    verified = read_state(hyprctl, deadline=deadline, presets=store.presets)
    expected_orientation = "vertical" if first.orientation == "horizontal" else "horizontal"
    if (
        verified.workspace != first.workspace
        or verified.addresses != first.addresses
        or verified.orientation != expected_orientation
    ):
        raise PaneRatioError("Hyprland did not toggle the requested split direction")

    intention = store.load().get(verified.workspace_name, "")
    if verified.orientation == "horizontal" and intention in store.presets:
        applied = reconcile(hyprctl, store, expected_workspace=verified.workspace)
        return applied.with_intent(
            intention,
            applied.phase,
            f"Switched to left and right. {applied.message}",
        )
    direction = "top and bottom" if verified.orientation == "vertical" else "left and right"
    return verified.with_intent(
        intention,
        "split_vertical" if verified.orientation == "vertical" else "split_horizontal",
        f"Switched to {direction}."
        + (f" Saved ratio {intention} is paused." if intention else ""),
    )


def set_workspace_layout(
    hyprctl: Hyprctl,
    store: IntentStore,
    layout_store: WorkspaceLayoutStore,
    target: str,
) -> LayoutState:
    if target not in (*WORKSPACE_LAYOUTS, "toggle"):
        raise PaneRatioError("unsupported workspace layout")
    deadline = time.monotonic() + APPLY_TIMEOUT_SECONDS
    first = read_state(hyprctl, deadline=deadline, presets=store.presets)
    intention = store.load().get(first.workspace_name, "")
    if not first.layout_eligible:
        return first.with_intent(
            intention,
            "paused_mode",
            "Workspace layout switching supports regular Dwindle and Scrolling workspaces only.",
        )
    if target == "toggle":
        target = "scrolling" if first.layout == "dwindle" else "dwindle"
    if first.layout == target:
        warning = ""
        try:
            layout_store.save(first.workspace, target)
        except WorkspaceLayoutPersistenceError as error:
            if not error.committed:
                raise
            warning = " Rule replacement completed, but disk durability could not be confirmed."
        return classify_with_intent(first, intention).with_intent(
            intention,
            "layout_current",
            f"Workspace already uses {target.title()}." + warning,
        )

    second = read_state(hyprctl, deadline=deadline, presets=store.presets)
    if (second.workspace, second.layout) != (first.workspace, first.layout):
        raise PaneRatioError("workspace layout changed while switching; try again")
    expression = (
        "local workspace=hl.get_active_workspace();"
        f'if workspace==nil or workspace.id~={second.workspace} '
        f'or workspace.tiled_layout~="{second.layout}" then '
        'error("Pane Ratio workspace changed") end;'
        f'hl.workspace_rule({{ workspace = "{second.workspace}", layout = "{target}" }})'
    )
    hyprctl.eval(expression, deadline=deadline)
    remaining = deadline - time.monotonic()
    if remaining <= 0:
        raise PaneRatioError("Pane Ratio operation timed out")
    time.sleep(min(0.08, remaining))
    verified = read_state(hyprctl, deadline=deadline, presets=store.presets)
    if verified.workspace != first.workspace or verified.layout != target:
        raise PaneRatioError("Hyprland did not apply the requested workspace layout")

    durability_warning = ""
    error_to_rollback: PaneRatioError | None = None
    try:
        layout_store.save(verified.workspace, target)
    except WorkspaceLayoutPersistenceError as error:
        if error.committed:
            durability_warning = (
                " Rule replacement completed, but disk durability could not be confirmed."
            )
        else:
            error_to_rollback = error
    except PaneRatioError as error:
        error_to_rollback = error

    if error_to_rollback is not None:
        rollback = (
            "local workspace=hl.get_active_workspace();"
            f'if workspace==nil or workspace.id~={verified.workspace} '
            f'or workspace.tiled_layout~="{target}" then '
            'error("Pane Ratio workspace changed") end;'
            f'hl.workspace_rule({{ workspace = "{verified.workspace}", layout = "{first.layout}" }})'
        )
        try:
            hyprctl.eval(rollback, deadline=deadline)
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise PaneRatioError("Pane Ratio operation timed out")
            time.sleep(min(0.08, remaining))
            restored = read_state(hyprctl, deadline=deadline, presets=store.presets)
            if restored.workspace != first.workspace or restored.layout != first.layout:
                raise PaneRatioError("Hyprland did not confirm the rollback")
        except PaneRatioError as rollback_error:
            raise PaneRatioError(
                "workspace layout changed but persistence and automatic rollback failed"
            ) from rollback_error
        raise PaneRatioError(
            "could not persist workspace layout; the runtime change was restored"
        ) from error_to_rollback

    final_state = read_state(hyprctl, deadline=deadline, presets=store.presets)
    if final_state.workspace == verified.workspace:
        if final_state.layout != target:
            layout_store.save(final_state.workspace, final_state.layout)
            raise PaneRatioError(
                "workspace layout changed concurrently; the observed layout was persisted"
            )
        verified = final_state

    if target == "dwindle" and intention in store.presets:
        if final_state.workspace != verified.workspace:
            return verified.with_intent(
                intention,
                "layout_dwindle",
                "Switched workspace to Dwindle. Saved ratio will resume when the workspace is active."
                + durability_warning,
            )
        try:
            applied = reconcile(
                hyprctl,
                store,
                expected_workspace=verified.workspace,
            )
        except ActiveWorkspaceChangedError:
            return verified.with_intent(
                intention,
                "layout_dwindle",
                "Switched workspace to Dwindle. Saved ratio will resume when the workspace is active."
                + durability_warning,
            )
        return applied.with_intent(
            intention,
            "layout_dwindle" if applied.phase != "applied" else "applied",
            f"Switched workspace to Dwindle. {applied.message}" + durability_warning,
        )
    return verified.with_intent(
        intention,
        f"layout_{target}",
        f"Switched workspace to {target.title()}."
        + (f" Saved ratio {intention} is paused." if intention else "")
        + durability_warning,
    )


def emit(payload: dict[str, Any]) -> None:
    print(json.dumps(payload, ensure_ascii=True, separators=(",", ":")))


def execute(
    arguments: list[str],
    hyprctl: Hyprctl,
    store: IntentStore,
    presets: dict[str, tuple[float, float]],
    layout_store: WorkspaceLayoutStore | None = None,
) -> int:
    if arguments == ["status"]:
        state = status_with_intent(hyprctl, store)
        emit(state.public(presets=presets))
        return 0
    if arguments == ["reconcile"]:
        state = reconcile(hyprctl, store)
        emit(state.public(presets=presets))
        return 0
    if arguments == ["split", "toggle"]:
        state = toggle_split(hyprctl, store)
        success = state.phase in ("split_vertical", "split_horizontal", "applied")
        emit(state.public(ok=success, presets=presets))
        return 0 if success else 2
    if len(arguments) == 3 and arguments[:2] == ["layout", "set"]:
        target = arguments[2]
        state = set_workspace_layout(
            hyprctl,
            store,
            layout_store or WorkspaceLayoutStore(),
            target,
        )
        success = state.phase in (
            "layout_current",
            "layout_dwindle",
            "layout_scrolling",
            "applied",
        )
        emit(state.public(ok=success, presets=presets))
        return 0 if success else 2
    if arguments == ["layout", "toggle"]:
        state = set_workspace_layout(
            hyprctl,
            store,
            layout_store or WorkspaceLayoutStore(),
            "toggle",
        )
        success = state.phase in ("layout_dwindle", "layout_scrolling", "applied")
        emit(state.public(ok=success, presets=presets))
        return 0 if success else 2
    if len(arguments) == 3 and arguments[:2] == ["intent", "set"]:
        ratio = arguments[2]
        if ratio not in presets:
            raise PaneRatioError("unsupported ratio preset")
        state = read_state(hyprctl, presets=presets)
        store.set(state.workspace_name, ratio)
        state = reconcile(hyprctl, store)
        emit(state.public(presets=presets))
        return 0
    if arguments == ["intent", "clear"]:
        state = read_state(hyprctl, presets=presets)
        store.clear(state.workspace_name)
        state = state.with_intent("", "no_intent", "Saved ratio removed from this workspace.")
        emit(state.public(presets=presets))
        return 0
    if len(arguments) == 2 and arguments[0] == "apply":
        state = apply_ratio(hyprctl, arguments[1], presets)
        emit(state.public(ok=state.eligible, presets=presets))
        return 0 if state.eligible else 2
    raise PaneRatioError(
        "usage: pane-ratio status | reconcile | intent set PRESET | intent clear | split toggle | layout set dwindle|scrolling | layout toggle"
    )


def main(arguments: list[str]) -> int:
    try:
        presets = load_presets()
        hyprctl = Hyprctl()
        store = IntentStore(presets=presets)
        layout_store = WorkspaceLayoutStore()
        with store.locked():
            return execute(arguments, hyprctl, store, presets, layout_store)
    except PaneRatioError as error:
        emit(
            {
                "ok": False,
                "eligible": False,
                "workspace": 0,
                "workspaceName": "",
                "layout": "unknown",
                "tiledWindows": 0,
                "orientation": "unknown",
                "ratio": "",
                "intentRatio": "",
                "state": "error",
                "message": str(error),
            }
        )
        return 1
    except Exception:
        emit(
            {
                "ok": False,
                "eligible": False,
                "workspace": 0,
                "workspaceName": "",
                "layout": "unknown",
                "tiledWindows": 0,
                "orientation": "unknown",
                "ratio": "",
                "intentRatio": "",
                "state": "error",
                "message": "Pane Ratio encountered an unexpected internal error.",
            }
        )
        return 1


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
